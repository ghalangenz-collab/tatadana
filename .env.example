# ==============================================================================
# TataDana Environment Variables
# Catat keuangan semudah chat — langsung dari Telegram kamu
# ==============================================================================

# Supabase (Postgres & Auth & Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_STORAGE_BUCKET=tatadana-exports

# Telegram Bot
# Token diperoleh dari @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
# Base URL publik untuk webhook Telegram (harus HTTPS, e.g. domain Vercel atau ngrok)
WEBHOOK_BASE_URL=https://tatadana.id

# AI Providers (Multi-provider fallback & extraction)
# Kunci API dikelola via Admin Dashboard atau fallback dari env ini
GEMINI_API_KEY=AIzaSy...
OPENAI_API_KEY=sk-...
DEEPSEEK_API_KEY=sk-...

# Midtrans Payment Gateway
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxx
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# App Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
TZ=Asia/Jakarta
